{
  "name": "@agent-wasm/native-wasm",
  "version": "0.0.0",
  "description": "CI-built wasm32-wasi (emnapi) substitutes for native N-API npm modules, plus the browser registry that wires them into @agent-wasm/core's require().",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "build-modules": "node scripts/build-module.mjs",
    "verify": "node scripts/verify-module.mjs",
    "type-check": "tsc --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "@agent-wasm/core": "workspace:*"
  },
  "devDependencies": {
    "@napi-rs/wasm-runtime": "^1.1.2",
    "emnapi": "^1.4.0"
  }
}
