{
  "name": "@agent-wasm/cli-tools",
  "version": "0.1.0",
  "description": "Browser wasm CLI tools for almostnode: a vim.wasm editor overlay and ffmpeg.wasm, exposed as terminal shell commands.",
  "private": false,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./vite": {
      "types": "./src/vite.ts",
      "import": "./src/vite.ts",
      "default": "./src/vite.ts"
    }
  },
  "scripts": {
    "test": "vitest run --passWithNoTests",
    "type-check": "tsc --project tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@agent-wasm/core": "workspace:*",
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "vim-wasm": "^0.0.13",
    "vite": "^7.0.0"
  },
  "peerDependenciesMeta": {
    "vite": { "optional": true }
  },
  "devDependencies": {
    "@agent-wasm/core": "workspace:*",
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@types/node": "^25.0.10",
    "jsdom": "^27.4.0",
    "typescript": "^5.9.3",
    "vim-wasm": "^0.0.13",
    "vite": "^7.3.1",
    "vitest": "4.0.18"
  },
  "license": "MIT",
  "sideEffects": false
}
