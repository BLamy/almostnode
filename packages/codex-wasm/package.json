{
  "name": "@agent-wasm/codex",
  "version": "0.1.0",
  "description": "Browser-hosted Codex sessions and WASM worker bridge for agent-wasm.",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./cli-browser-worker": {
      "types": "./dist/cli-browser-worker.d.ts",
      "import": "./dist/cli-browser-worker.js",
      "default": "./dist/cli-browser-worker.js"
    },
    "./app-server-browser-worker": {
      "types": "./dist/app-server-browser-worker.d.ts",
      "import": "./dist/app-server-browser-worker.js",
      "default": "./dist/app-server-browser-worker.js"
    }
  },
  "scripts": {
    "build": "npm run build:js",
    "build:js": "tsup src/index.ts src/cli-browser-worker.ts src/app-server-browser-worker.ts --tsconfig tsconfig.build.json --format esm --dts --clean --external @bokuweb/zstd-wasm && node scripts/patch-dist-worker-urls.mjs",
    "build:adapter": "node scripts/build-adapter.mjs",
    "build:publish": "npm run build:js && npm run build:adapter",
    "smoke:adapter": "node tests/browser-wasm-smoke.mjs && node tests/app-server-browser-wasm-smoke.mjs",
    "test": "vitest run",
    "type-check": "tsc --project tsconfig.json --noEmit",
    "check:codex-wasm": "node scripts/check-codex-wasm.mjs",
    "prepublishOnly": "npm run test && npm run build:publish"
  },
  "devDependencies": {
    "@types/node": "^25.0.10",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "4.0.18"
  },
  "dependencies": {
    "@bokuweb/zstd-wasm": "^0.0.27"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BLamy/agent-wasm.git"
  },
  "sideEffects": false
}
