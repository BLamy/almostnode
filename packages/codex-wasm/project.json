{
  "name": "codex-wasm",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/codex-wasm/src",
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm run build",
        "cwd": "packages/codex-wasm"
      }
    },
    "build-adapter": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "node scripts/build-adapter.mjs",
        "cwd": "packages/codex-wasm"
      }
    },
    "smoke-adapter": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tests/browser-wasm-smoke.mjs && node tests/app-server-browser-wasm-smoke.mjs",
        "cwd": "packages/codex-wasm"
      },
      "dependsOn": ["build-adapter"]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run",
        "cwd": "packages/codex-wasm"
      }
    },
    "type-check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --project tsconfig.json --noEmit",
        "cwd": "packages/codex-wasm"
      }
    },
    "check-codex-wasm": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/check-codex-wasm.mjs",
        "cwd": "packages/codex-wasm"
      }
    }
  }
}
