{
  "name": "agent-wasm-workspace",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "pnpm nx serve-examples almostnode",
    "dev:web-ide": "pnpm nx dev web-ide",
    "dev:sdk-showcase": "pnpm vendor:install:opencode && pnpm nx dev sdk-showcase",
    "dev:mobile-ide": "pnpm nx dev mobile-ide",
    "vendor:install:opencode": "node scripts/vendor-install-opencode.js",
    "vendor:install:codex": "node scripts/vendor-install-codex.js",
    "tailscale:build-connect": "node scripts/build-tailscale-connect.mjs",
    "headscale:test-browser-ts2021": "cd vendor/headscale && go test ./hscontrol -run 'TestTS2021UpgradeRoutes|TestNoiseBodyLimit'",
    "headscale:wasm-demo": "tsx scripts/run-headscale-wasm-demo.ts",
    "build": "pnpm nx run-many -t build",
    "build:lib": "pnpm nx build almostnode",
    "build:mobile-ide": "pnpm nx build mobile-ide",
    "build:types": "pnpm nx build-types almostnode",
    "package:preflight": "node scripts/package-preflight.mjs",
    "package:publish": "node scripts/package-publish.mjs",
    "test": "pnpm nx run-many -t test",
    "test:run": "pnpm nx run-many -t test",
    "test:e2e": "pnpm nx run-many -t e2e",
    "type-check": "pnpm nx run-many -t type-check"
  },
  "devDependencies": {
    "@nx/js": "^21.3.2",
    "@nx/playwright": "^21.3.2",
    "@nx/vite": "^21.3.2",
    "@playwright/test": "^1.58.0",
    "nx": "^21.3.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.5.0"
  },
  "packageManager": "pnpm@10.15.0+sha512.486ebc259d3e999a4e8691ce03b5cac4a71cbeca39372a9b762cb500cfdf0873e2cb16abe3d951b1ee2cf012503f027b98b6584e4df22524e0c7450d9ec7aa7b"
}
